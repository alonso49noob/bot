# Copia este archivo a .env y rellénalo. NUNCA subas el .env real.
DISCORD_TOKEN=
GEMINI_API_KEY=

# Opcionales
GEMINI_MODEL=gemini-3.8-flash
# Canales donde responde SIEMPRE, sin mención (IDs separados por coma)
CHAT_CHANNEL_IDS=

# Respaldo opcional con cualquier API compatible con OpenAI (se usa si Gemini falla o se queda sin cuota).
# Ejemplo con FreeLLMAPI local: OPENAI_BASE_URL=http://localhost:3001/v1  OPENAI_MODEL=auto
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=auto
# Orden de proveedores (gemini, openai). Por defecto: gemini y luego openai si hay OPENAI_BASE_URL.
LLM_PROVIDERS=
