# Copia este archivo a .env y rellénalo. NUNCA subas el .env real.
DISCORD_TOKEN=
GEMINI_API_KEY=

# Opcionales
GEMINI_MODEL=gemini-3.8-flash
# Canales donde responde SIEMPRE, sin mención (IDs separados por coma)
CHAT_CHANNEL_IDS=

# --- Proveedores (se prueban en orden; si uno falla o se queda sin cuota, pasa al siguiente) ---
# Orden. Cada nombre distinto de "gemini" necesita NOMBRE_BASE_URL, NOMBRE_API_KEY y NOMBRE_MODEL (en mayúsculas).
LLM_PROVIDERS=groq,openrouter,gemini

# Groq (https://console.groq.com)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (https://openrouter.ai). Usa un modelo con sufijo :free; la lista cambia, mírala en su web.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Otros servicios con formato OpenAI: añade NOMBRE_BASE_URL / NOMBRE_API_KEY / NOMBRE_MODEL y ponlo en LLM_PROVIDERS.

# Caracteres de documentación que se envían a los proveedores que no son Gemini (las capas gratis limitan los tokens)
OPENAI_CONTEXT_CHARS=14000
